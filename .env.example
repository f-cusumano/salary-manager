# =====================================================================================================
# Salary Manager - modello del file .env: copialo in .env (ignorato da git, non committarlo mai) e compila solo i
# valori che servono. Le righe commentate mantengono il default dell'applicazione o di docker-compose.yml.
# Lo leggono Docker Compose e il backend avviato con mvnw dalla cartella backend/ (che cerca ../.env).
# Le variabili marcate (solo Docker Compose) non hanno effetto con mvnw, quelle (solo mvnw) non ne hanno con Compose.
#
# Formato (lo stesso di Docker Compose; dettagli nel README, sezione "File .env"), codifica UTF-8:
#   NOME=valore               spazi attorno a = e in fondo ignorati; "export " davanti al nome facoltativo
#   NOME=valore # nota        commento in linea: spazio seguito da # (senza spazio il # fa parte del valore)
#   NOME=C:\cartella\dati     la \ resta com'e': i percorsi Windows si scrivono come sono
#   NOME=${ALTRA:-default}    il $ sostituisce le variabili (d'ambiente o delle righe sopra); $$ e' un $ letterale
#   NOME='Pa$sw0rd #1'        tra apici singoli il valore e' letterale ($ compreso): usarli per le password con $
#                             (\' vale come apice, quindi il valore non puo' finire con \)
#   NOME="riga\nriga"         tra virgolette doppie valgono \n \r \t \\ \" \$ e la sostituzione del $
#   NOME=                     vuota: come non impostata con mvnw; per tornare al default commentare la riga
# Una riga non valida, o un $ con una variabile non definita, blocca l'avvio del backend con il numero di riga.
# Le variabili d'ambiente vere hanno la precedenza su questo file.
# =====================================================================================================

# Lettore dei cedolini:
#   locale  (default) gratuito e offline: legge il testo dei PDF dei layout supportati (JOB Sistemi, Zucchetti,
#           modulo M39320); non legge scansioni ne' layout sconosciuti (il caricamento va in errore con un messaggio)
#   claude  Claude tramite l'API Anthropic: legge qualsiasi cedolino, anche scansioni, ma e' a pagamento (crediti API
#           separati dall'abbonamento a Claude) e richiede ANTHROPIC_API_KEY
#   fixture modalita' demo con dati inventati, nessuna lettura reale
# SAM_LETTORE=locale

# Chiave API Anthropic (solo con SAM_LETTORE=claude)
# ANTHROPIC_API_KEY=
# Modello ed effort di Claude (solo con SAM_LETTORE=claude; default: claude-opus-5-5, medium)
# SAM_AI_MODEL=claude-opus-5-5
# SAM_AI_EFFORT=medium

# Password da provare sui PDF protetti, separate da virgola (dopo quella indicata nel caricamento)
# SAM_PDF_PASSWORD_CANDIDATE=

# Nomi host con cui si apre l'applicazione, separati da virgola: se e' raggiungibile da altri computer
# (SAM_BIND_ADDRESS=0.0.0.0 o SAM_SERVER_ADDRESS=0.0.0.0) aggiungere il nome o l'indirizzo che usano
# (le richieste per nomi non ammessi ricevono 400)
# SAM_ALLOWED_HOSTS=localhost,127.0.0.1,[::1],::1

# Backend avviato con mvnw (solo mvnw): porta e interfaccia di ascolto (in fase 1 non c'e' login: lasciare 127.0.0.1)
# SAM_PORT=8080
# SAM_SERVER_ADDRESS=127.0.0.1

# Porte sull'host e interfaccia su cui pubblicarle (solo Docker Compose; in fase 1 non c'e' login: lasciare 127.0.0.1)
# SAM_FRONTEND_PORT=8081
# SAM_BACKEND_PORT=8080
# SAM_BIND_ADDRESS=127.0.0.1

# Opzioni della JVM e fuso orario del backend (solo Docker Compose)
# SAM_JAVA_OPTS=-XX:MaxRAMPercentage=75.0 -XX:+ExitOnOutOfMemoryError
# SAM_TZ=Europe/Rome
