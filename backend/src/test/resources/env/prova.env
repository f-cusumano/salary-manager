# File .env di prova per ConfigurazioneFileEnvTest (sintassi di Docker Compose): solo valori inventati
ANTHROPIC_API_KEY="sk-ant-chiave-inventata"   # tra virgolette, con commento in linea
export SAM_AI_MODEL=claude-modello-di-prova
SAM_PROVA_SEGNAPOSTO=valore-dal-file-env
SAM_PROVA_VARIANTE=dal-file-base
# Tra apici singoli il ${...} resta letterale anche passando da un segnaposto di application.yml
SAM_PROVA_LETTERALE='utente${SAM_PROVA_SEGNAPOSTO}'
# $$ e' un $ letterale, come in Docker Compose
SAM_PROVA_DOLLARO=Pa$$w0rd
# Vuota: come se non ci fosse, vale il default del segnaposto
SAM_PROVA_VUOTA=
SAM_SERVER_ADDRESS=
